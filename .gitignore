# --- Python ---
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.coverage
.ipynb_checkpoints/

# --- Node / Next.js ---
node_modules/
.next/
out/
.npm/
*.tsbuildinfo
next-env.d.ts

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
.claude/

# --- macOS / OS junk ---
.DS_Store
Thumbs.db

# --- Environment & secrets ---
.env
.env.local
.env.*.local
*.pem

# --- ML model caches (HuggingFace, Torch hub) ---
backend/models/*
!backend/models/.gitkeep
# The two trained classifiers are tracked deliberately (~6MB total). The
# Korean one cannot be regenerated without the AIHub dataset, which is
# access-gated and not in this repo, so the file itself is the only copy.
!backend/models/emotion_clf.joblib
!backend/models/korean_clf.joblib

# --- Large data ---
data/datasets/*
!data/datasets/.gitkeep
data/timelines/*
!data/timelines/.gitkeep

# Responses collected from real people. Viewer feedback holds the numeric
# feature vector of what someone said; calibration holds what a named group of
# participants answered. Neither belongs in a public repository.
data/feedback/*
!data/feedback/.gitkeep
data/calibration/*
!data/calibration/.gitkeep

# Sample audio is small and useful for collaborators — keep it tracked.
# If you commit copyrighted clips (drama scenes), uncomment to ignore:
# data/samples/*.mp4
# data/samples/*.mp3

# --- Build / logs ---
*.log
dist/
build/

# Local screen recordings (large, not part of the repo history)
*.mov

